# Application
APP_NAME=InterviewAI Backend
ENVIRONMENT=development

# Security — replace with a strong private secret in your local .env
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — use your local PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/interview_ai

# AI / LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
